{
  "name": "gc-mediapipe",
  "version": "0.9.01",
  "description": "Electron + MediaPipe hand tracking lab for students",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/vendor-mediapipe.cjs",
    "start": "electron .",
    "clean": "node scripts/clean.cjs",
    "dist": "node scripts/dist.cjs",
    "dist:all": "electron-builder --publish never"
  },
  "keywords": ["electron", "mediapipe", "hand-tracking", "education"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.34",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "34.5.8",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.handlab.mediapipe",
    "productName": "Hand Lab",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "asarUnpack": ["vendor/**"],
    "mac": {
      "category": "public.app-category.education",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Hand Lab uses the camera so you can experiment with on-device hand tracking."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "directories": {
      "output": "dist"
    }
  }
}
